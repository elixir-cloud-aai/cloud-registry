{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "host_name": {
      "type": "string",
      "description": "Public host name of the app"
    },
    "config": {
      "type": ["object", "null"],
      "description": "App config overriding the base config in the image"
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "MongoDB image, pinned to a minor version"
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Require MongoDB credentials"
            },
            "existingSecret": {
              "type": "string",
              "description": "Secret with the MongoDB credentials; required if authentication is enabled"
            }
          }
        }
      }
    },
    "cloud_registry": {
      "type": "object",
      "required": ["image", "probePath"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "App image repository, optionally with a tag or digest"
        },
        "tag": {
          "type": "string",
          "description": "App image tag; defaults to the chart's appVersion"
        },
        "probePath": {
          "type": "string",
          "pattern": "^/",
          "description": "Path of the app's probes"
        }
      }
    }
  }
}
