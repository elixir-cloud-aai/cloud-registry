{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "host_name": {
      "type": "string",
      "description": "Public host name of the app"
    },
    "config": {
      "type": ["object", "null"],
      "description": "App config overriding the base config in the image"
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "cloud_registry": {
      "type": "object",
      "properties": {
        "probePath": {
          "type": "string",
          "pattern": "^/",
          "description": "Path of the app's probes"
        }
      }
    }
  }
}
